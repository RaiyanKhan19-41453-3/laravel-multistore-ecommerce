# ============================================================
# Setup: copy this file to .env and fill in your own values.
# Every key below explains itself. Leave an optional integration
# blank to keep it disabled. Never commit the real .env to git.
# ============================================================

# Human name shown in mails, invoices, and the browser title.
APP_NAME=Laravel
# local | staging | production. Production disables debug pages.
APP_ENV=local
# App secret for cookies/sessions. Generate: php artisan key:generate
APP_KEY=
# Detailed error pages. MUST be false in production.
APP_DEBUG=true
# Default timezone for dates, order numbers, and reports.
APP_TIMEZONE=Asia/Dhaka
# Public base URL of this install (links, gateway callbacks, webhooks).
APP_URL=http://localhost:8000

# ---- Production checklist (uncomment and set on the server) ----
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=your-store.com
# If behind a load balancer / Cloudflare, configure trusted proxies in
# bootstrap/app.php so audit IPs and HTTPS detection stay correct.

# Display language, its fallback, and faker locale for seeders.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance-mode storage. file = storage/framework/down; use database
# only when several web servers share one DB.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Dev-server workers for php artisan serve. Ignored under Nginx/Octane.
PHP_CLI_SERVER_WORKERS=4

# Password hashing cost. Higher = slower logins, stronger hashes.
BCRYPT_ROUNDS=12

# Logging: stacked channels, single-file driver, no deprecation channel.
# Use LOG_LEVEL=error in production to cut noise.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database connection for the shop itself. Tests always override these
# with in-memory sqlite via phpunit.xml, so these only affect dev/prod.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

# Web sessions: database driver, 2-hour lifetime, unencrypted cookie
# payload, site-wide path, first-party domain (null = current host).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast events sink (log = local file, fine without websockets),
# default uploaded-file disk, and queue driver for jobs/mail/SMS.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# App cache: database driver, no key prefix. Switch to redis/memcached
# in production if the DB becomes a bottleneck.
CACHE_STORE=database
CACHE_PREFIX=

# Memcached server (only used when CACHE_STORE=memcached).
MEMCACHED_HOST=127.0.0.1

# Redis server (only used when a *_STORE is set to redis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail (order confirmations, back-in-stock). Blank username and
# password disables sending; mails are queued, never sent inside requests.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage for product images (unused when blank;
# uploads stay on FILESYSTEM_DISK instead).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# App name exposed to Vite/frontend builds.
VITE_APP_NAME="${APP_NAME}"

# SSLCommerz (Bangladesh cards + mobile banking). Get the store ID and
# password from your SSLCommerz merchant panel. SANDBOX=true points at
# the test gateway with the public testbox/qwerty credentials.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash tokenized checkout. Credentials come from the bKash merchant
# portal; SANDBOX=true uses the public sandbox app key/secret.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Moyasar (Saudi Mada / cards / Apple Pay). No sandbox flag: point
# BASE_URL at Moyasar's test endpoint to trial without real money.
MOYASAR_API_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_BASE_URL=https://api.moyasar.com

# Tabby buy-now-pay-later (Saudi). Test keys start with sk_test_/pk_test_.
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_BASE_URL=https://api.tabby.ai

# Stripe (international cards). Test keys start with sk_test_/pk_test_.
# WEBHOOK_SECRET is reserved for future signature checks (verification
# currently re-fetches the session from Stripe instead).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# Which payment buttons the storefront checkout offers. These are the
# baseline: Admin > Settings > Payments toggles override them per store.
# NAGAD/ROCKET have flags but no implementation yet and stay hidden.
PAYMENT_GATEWAY=sslcommerz
PAYMENT_COD_ENABLED=true
PAYMENT_SSLCOMMERZ_ENABLED=true
PAYMENT_BKASH_ENABLED=false
PAYMENT_NAGAD_ENABLED=false
PAYMENT_ROCKET_ENABLED=false
PAYMENT_MOYASAR_ENABLED=false
PAYMENT_TABBY_ENABLED=false
PAYMENT_STRIPE_ENABLED=false
# Re-verify every "paid" webhook with the gateway before confirming the
# order. Never false in production: forged webhooks would confirm orders.
VERIFY_PAYMENT_WEBHOOKS=true
# Minutes an unpaid online order holds its stock before auto-expiring.
# COD orders never expire (null TTL for cod).
ORDER_RESERVATION_TTL=15

# Public storefront base URL (SPA links, QR payloads) and Sanctum
# personal-token lifetime in minutes (10080 = 7 days).
FRONTEND_URL=http://localhost:8000
SANCTUM_TOKEN_EXPIRATION=10080

# Platform billing (SaaS subscriptions gating admin/storefront access).
# OFF by default so installs and tests keep working; enable only after
# every store has an active subscription or trial window.
# PLATFORM_BILLING_ENFORCED=false
# PLATFORM_BILLING_TRIAL_DAYS=14

# Discount combination mode: single_winner, waterfall, best_per_line.
# Admin > Discounts can narrow this per campaign.
DISCOUNT_COMBINATION_MODE=waterfall

# Store identity defaults for fresh installs. Admin > Settings can
# override all of these per store afterwards.
STORE_NAME="${APP_NAME}"
STORE_COUNTRY=BD
STORE_CURRENCY=BDT
STORE_LOCALE=en
STORE_TIMEZONE=Asia/Dhaka

# Generic tax engine: off | vat | gst. ZATCA builds on vat mode for SA.
# RATE is a percent, INCLUSIVE prices already contain the tax, LABEL is
# the word printed on invoices, and the category lists hold slugs that
# are zero-rated or fully exempt.
TAX_MODE=off
TAX_RATE=0
TAX_INCLUSIVE=false
TAX_LABEL=VAT
TAX_ZERO_RATED_CATEGORIES=
TAX_EXEMPT_CATEGORIES=

# ZATCA e-invoicing (Saudi Arabia only). Leave disabled for non-Saudi
# stores. VAT_RATE is the 15% standard rate; SELLER_* is the merchant
# profile printed on invoices and QR codes; ENDPOINT_* and API_BASE
# target the Fatoora portal (SANDBOX=true = developer portal).
# DEVICE_SERIAL/CSID/PRIVATE_KEY/CERTIFICATE come from the onboarding
# (compliance CSID) flow; REPORTING_MAX_ATTEMPTS bounds background retries.
ZATCA_ENABLED=false
ZATCA_VAT_RATE=15.0
ZATCA_SELLER_NAME_AR=
ZATCA_SELLER_NAME=
ZATCA_VAT_NUMBER=
ZATCA_CR_NUMBER=
ZATCA_SELLER_STREET=
ZATCA_SELLER_BUILDING=
ZATCA_SELLER_CITY=
ZATCA_SELLER_POSTAL=
ZATCA_SELLER_COUNTRY=SA
ZATCA_ZERO_RATED_CATEGORIES=
ZATCA_EXEMPT_CATEGORIES=
ZATCA_SANDBOX=true
ZATCA_ENDPOINT_COMPLIANCE=/compliance
ZATCA_ENDPOINT_PRODUCTION_CSIDS=/production/csids
ZATCA_ENDPOINT_CLEARANCE=/invoices/clearance/single
ZATCA_ENDPOINT_REPORTING=/invoices/reporting/single
ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_DEVICE_SERIAL=
ZATCA_CSID=
ZATCA_PRIVATE_KEY=
ZATCA_CERTIFICATE=
ZATCA_REPORTING_MAX_ATTEMPTS=10

# OTP SMS provider: twilio or ssl_wireless (see sections below).
# OTP_LENGTH digits, expiring after OTP_EXPIRY_MINUTES.
SMS_GATEWAY=twilio
SMS_TWILIO_ENABLED=false
SMS_SSL_WIRELESS_ENABLED=false
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRY_MINUTES=10

# Twilio account: SID + token authenticate, FROM_NUMBER sends.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SSL Wireless (Bangladesh): API token plus sender SID.
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=

# Customer notifications (order placed/confirmed/shipped...). Overridable
# per store from admin settings. SMS stays off until a provider above is
# configured; the SMS job no-ops without one so tests never hit HTTP.
NOTIFICATIONS_MAIL_ENABLED=true
NOTIFICATIONS_SMS_ENABLED=false

# In-admin product label printing: barcode symbology, max labels per
# batch, and default paper layout.
BARCODE_TYPE=code128
BARCODE_MAX_LABELS=500
BARCODE_DEFAULT_LAYOUT=a4-40

# Couriers (config/couriers.php reads these). ENABLED=true shows the
# courier in admin; the credential lines decide if it is *configured*.
# Leave credentials blank to keep a courier visible-but-unusable, or set
# ENABLED=false to hide it entirely. API keys come from each courier's
# own merchant portal.
PATHAO_ENABLED=true
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PAPERFLY_ENABLED=true
PAPERFLY_MERCHANT_ID=
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
SA_PARIBAHAN_ENABLED=true
SA_PARIBAHAN_API_KEY=
SA_PARIBAHAN_BOOKING_BRANCH=
SUNDARBAN_ENABLED=true
SUNDARBAN_API_KEY=
SUNDARBAN_BOOKING_USER_ID=
ECOURIER_ENABLED=true
ECOURIER_USER_ID=
ECOURIER_API_KEY=
STEADFAST_ENABLED=true
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_ENABLED=true
REDX_API_TOKEN=
SMSA_ENABLED=true
SMSA_API_KEY=
SMSA_BASE_URL=
ARAMEX_ENABLED=true
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_PIN=
ARAMEX_BASE_URL=
# Fallback row for hand-entered consignments (booking done on the
# courier's own app). Never needs credentials.
OTHER_COURIER_ENABLED=true
# Webhook signing secrets: paste the secret each courier's panel shows
# so inbound status pushes can be verified. Blank = unverified (the
# admin test-connection button reports the state per courier).
PATHAO_WEBHOOK_SECRET=
PAPERFLY_WEBHOOK_SECRET=
SA_PARIBAHAN_WEBHOOK_SECRET=
SUNDARBAN_WEBHOOK_SECRET=
ECOURIER_WEBHOOK_SECRET=
STEADFAST_WEBHOOK_SECRET=
REDX_WEBHOOK_SECRET=
SMSA_WEBHOOK_SECRET=
ARAMEX_WEBHOOK_SECRET=
# Sandbox switches where the courier offers one (test parcels, no rider
# dispatched). Couriers without a flag use BASE_URL overrides instead.
PATHAO_SANDBOX=true
REDX_SANDBOX=true
SMSA_SANDBOX=false
