APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

# ---- Production checklist (uncomment and set on the server) ----
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=your-store.com
# If behind a load balancer / Cloudflare, configure trusted proxies in
# bootstrap/app.php so audit IPs and HTTPS detection stay correct.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash Payment Gateway
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Moyasar (Saudi Mada / Cards / Apple Pay)
MOYASAR_API_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_BASE_URL=https://api.moyasar.com

# Tabby BNPL (Saudi)
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_BASE_URL=https://api.tabby.ai

# Stripe (International Cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# Payment Gateway Enable/Disable
PAYMENT_GATEWAY=sslcommerz
PAYMENT_COD_ENABLED=true
PAYMENT_SSLCOMMERZ_ENABLED=true
PAYMENT_BKASH_ENABLED=false
PAYMENT_NAGAD_ENABLED=false
PAYMENT_ROCKET_ENABLED=false
PAYMENT_MOYASAR_ENABLED=false
PAYMENT_TABBY_ENABLED=false
PAYMENT_STRIPE_ENABLED=false
VERIFY_PAYMENT_WEBHOOKS=true
ORDER_RESERVATION_TTL=15

FRONTEND_URL=http://localhost:8000
SANCTUM_TOKEN_EXPIRATION=10080

# Discount combination mode: single_winner, waterfall, best_per_line
DISCOUNT_COMBINATION_MODE=waterfall

# Store identity — overridable per client in Admin > Settings
STORE_NAME="${APP_NAME}"
STORE_COUNTRY=BD
STORE_CURRENCY=BDT
STORE_LOCALE=en
STORE_TIMEZONE=Asia/Dhaka

# Generic tax (off | vat | gst) — ZATCA builds on vat mode for SA
TAX_MODE=off
TAX_RATE=0
TAX_INCLUSIVE=false
TAX_LABEL=VAT
TAX_ZERO_RATED_CATEGORIES=
TAX_EXEMPT_CATEGORIES=

# ZATCA E-Invoicing (Saudi Arabia) — leave disabled for non-Saudi stores
ZATCA_ENABLED=false
ZATCA_VAT_RATE=15.0
ZATCA_SELLER_NAME_AR=
ZATCA_SELLER_NAME=
ZATCA_VAT_NUMBER=
ZATCA_CR_NUMBER=
ZATCA_SELLER_STREET=
ZATCA_SELLER_BUILDING=
ZATCA_SELLER_CITY=
ZATCA_SELLER_POSTAL=
ZATCA_SELLER_COUNTRY=SA
ZATCA_ZERO_RATED_CATEGORIES=
ZATCA_EXEMPT_CATEGORIES=
ZATCA_SANDBOX=true
ZATCA_ENDPOINT_COMPLIANCE=/compliance
ZATCA_ENDPOINT_PRODUCTION_CSIDS=/production/csids
ZATCA_ENDPOINT_CLEARANCE=/invoices/clearance/single
ZATCA_ENDPOINT_REPORTING=/invoices/reporting/single
ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_DEVICE_SERIAL=
ZATCA_CSID=
ZATCA_PRIVATE_KEY=
ZATCA_CERTIFICATE=
ZATCA_REPORTING_MAX_ATTEMPTS=10

# SMS Gateway
SMS_GATEWAY=twilio
SMS_TWILIO_ENABLED=false
SMS_SSL_WIRELESS_ENABLED=false
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRY_MINUTES=10

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SSL Wireless
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=

# Customer notifications (overridable from admin settings)
NOTIFICATIONS_MAIL_ENABLED=true
NOTIFICATIONS_SMS_ENABLED=false

# Product label printing
BARCODE_TYPE=code128
BARCODE_MAX_LABELS=500
BARCODE_DEFAULT_LAYOUT=a4-40

# Couriers (config/couriers.php reads these; leave blank to keep a courier unconfigured)
PATHAO_ENABLED=true
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PAPERFLY_ENABLED=true
PAPERFLY_MERCHANT_ID=
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
SA_PARIBAHAN_ENABLED=true
SA_PARIBAHAN_API_KEY=
SA_PARIBAHAN_BOOKING_BRANCH=
SUNDARBAN_ENABLED=true
SUNDARBAN_API_KEY=
SUNDARBAN_BOOKING_USER_ID=
ECOURIER_ENABLED=true
ECOURIER_USER_ID=
ECOURIER_API_KEY=
STEADFAST_ENABLED=true
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_ENABLED=true
REDX_API_TOKEN=
SMSA_ENABLED=true
SMSA_API_KEY=
SMSA_BASE_URL=
ARAMEX_ENABLED=true
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_PIN=
ARAMEX_BASE_URL=
OTHER_COURIER_ENABLED=true
PATHAO_WEBHOOK_SECRET=
PAPERFLY_WEBHOOK_SECRET=
SA_PARIBAHAN_WEBHOOK_SECRET=
SUNDARBAN_WEBHOOK_SECRET=
ECOURIER_WEBHOOK_SECRET=
STEADFAST_WEBHOOK_SECRET=
REDX_WEBHOOK_SECRET=
SMSA_WEBHOOK_SECRET=
ARAMEX_WEBHOOK_SECRET=
PATHAO_SANDBOX=true
REDX_SANDBOX=true
SMSA_SANDBOX=false
